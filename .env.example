# DataScope Enterprise Business Intelligence Platform — Environment Configuration
# Copy this file to .env (backend) and frontend/.env (frontend) with your Supabase credentials.

# ==============================================================================
# 1. Supabase Backend Configuration (FastAPI)
# ==============================================================================
# Obtain these from your Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Database URL (Point to Supabase PostgreSQL or SQLite fallback for offline unit tests)
DATABASE_URL=sqlite:///./datascope.db

# Backend Security & JWT
SECRET_KEY=datascope-super-secret-key-change-in-production-2026-secure-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# ==============================================================================
# 2. Google OAuth 2.0 Integration (Supabase Auth / PKCE)
# ==============================================================================
# Obtain from Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# ==============================================================================
# 3. Frontend Environment Configuration (Vite + React)
# Save as frontend/.env
# ==============================================================================
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your-anon-key
# VITE_API_BASE_URL=http://localhost:8000
